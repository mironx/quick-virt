#cloud-config
# Placeholder — identical to master-user-data.tmpl. Customize per role
# (e.g. control-plane vs node packages) when needed.
users:
  - name: ${user_name}
    groups: sudo, wheel
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: false
    ssh-authorized-keys:
      - ${ssh_pub_key}
    plain_text_passwd: '${user_password}'

packages:
  - qemu-guest-agent
  - nginx
  - tilde

runcmd:
  - systemctl enable --now qemu-guest-agent