# Generated by quick-access-ssh — do not edit manually
# Edits will be overwritten on next `terraform apply`.
#
# Use directly:    ssh -F <this-file> <vm-name>
# Or include from ~/.ssh/config:
#   Include /abs/path/to/.qv-access/ssh-config

%{ for vm in vms ~}
# ${vm.name}
%{ for entry in vm.entries ~}
Host ${entry.host}
  HostName ${entry.ip}
  User ${ssh.user}
  IdentityFile ${ssh.identity_file}
%{ if relaxed_host_keys ~}
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
%{ endif ~}

%{ endfor ~}
%{ endfor ~}
