# =============================================================================
# qv-throttle — VM-to-profile mapping (prefix: ${prefix})
# =============================================================================
# Generated by quick-throttle-apply at ${generated_at}.
#
# All fields start as 'null'. Edit this file MANUALLY to assign profiles
# during chaos sessions. The downstream apply.sh interprets each value as:
#
#   null            → reset that axis to defaults (unthrottle)
#   <filename>.ini  → literal filename in .qv-limits/ (e.g. ${prefix}-cpu-cap25.ini)
#
# Per-target axes use dot-suffix notation:
#   disk_profile.<dev>    — one line per writable disk (vda, vdb, ...)
#   network_profile.<idx> — one line per network interface (0, 1, ...)
#
# This file is regenerated when the set of VMs / their disks / networks
# changes. Pure-edit sessions (no HCL change) are preserved.
# =============================================================================
%{ if length(available_profiles.cpu) + length(available_profiles.disk) + length(available_profiles.network) > 0 ~}
#
# Available profiles in this dir (copy filename into the values below):
#
%{ for axis in ["cpu", "disk", "network"] ~}
#   ${format("%-8s", axis)} ${length(available_profiles[axis]) > 0 ? join(", ", available_profiles[axis]) : "(none defined)"}
%{ endfor ~}
# =============================================================================
%{ endif ~}

[meta]
format_version = 1
prefix         = ${prefix}
generated_at   = ${generated_at}
generated_by   = quick-throttle-apply

%{ for vm in vms ~}
[${vm.name}]
cpu_profile        = null
%{ for dev in vm.disks ~}
disk_profile.${dev}   = null
%{ endfor ~}
%{ for idx in vm.network_indices ~}
network_profile.${idx}  = null
%{ endfor ~}

%{ endfor ~}
