#cloud-config
# Swap configuration fragment. Rendered by quick-vm when var.swap_level != null.
# ASCII only (cc_write_files crashes on non-ASCII chars).
#
# Two halves:
#  1. bootcmd + sysctl.d file + apply-script in write_files (this fragment)
#  2. /usr/local/bin/quick-vm-swap-apply.sh in run_after (injected by main.tf
#     into the run-after.cfg MIME fragment, which uses cloud-config-runcmd.tmpl
#     -- the same merge-safe pattern as install-k0s.sh / install-kafka.sh)
#
# Why split: cloud-init merge for a fragment with 3 top-level keys (bootcmd +
# write_files + runcmd) silently drops the runcmd half when base.cfg user_data
# has a runcmd. The run_after pathway uses a 1-key fragment (runcmd: only) that
# merges cleanly -- proven by k0s/k3s/rke2 install scripts working.
merge_how:
 - name: list
   settings: [append]
 - name: dict
   settings: [no_replace, recurse_list]

%{ if disabled ~}
bootcmd:
  - swapoff -a
  - sed -i.bak '/[ \t]swap[ \t]/s/^/#/' /etc/fstab
%{ endif ~}

write_files:
  - path: /etc/sysctl.d/99-quick-vm-swap.conf
    owner: root:root
    permissions: '0644'
    content: |
      # Managed by quick-vm (var.swap_level=${level})
      vm.swappiness = ${swappiness}

  - path: /usr/local/bin/quick-vm-swap-apply.sh
    owner: root:root
    permissions: '0755'
    content: |
      #!/bin/bash
      # Managed by quick-vm. Applies swap policy AFTER cloud-init has written
      # /etc/sysctl.d/99-quick-vm-swap.conf. Idempotent -- safe to re-run.
      set -e
      exec > /var/log/quick-vm-swap-apply.log 2>&1
      echo "[$(date)] applying swap_level=${level}"
%{ if disabled ~}
      swapoff -a 2>/dev/null || true
      sed -i.bak '/[ \t]swap[ \t]/s/^/#/' /etc/fstab
%{ endif ~}
      sysctl -p /etc/sysctl.d/99-quick-vm-swap.conf
      echo "[$(date)] done. swappiness=$(cat /proc/sys/vm/swappiness) /proc/swaps_lines=$(wc -l < /proc/swaps)"
