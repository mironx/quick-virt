#--------------------------------------------------- ${vm_name}
# Auto-generated by quick-virt. Do not edit manually.
#
# Use directly:   ssh -F qv-ssh.config.${vm_name}.conf <host>
# Or include in ~/.ssh/config:   Include /abs/path/to/qv-ssh.config.${vm_name}.conf
# Or compose all fragments into one file:   task ssh:compose [DIR=<path>]
#---------------------------------------------------
%{ for e in entries ~}

Host ${e.host}
  HostName ${e.ip}
%{ if ssh_user != "" ~}
  User ${ssh_user}
%{ endif ~}
  IdentityFile ${identity_file}
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  LogLevel ERROR
%{ endfor ~}