# =============================================================================
# quick-throttle — Disk I/O limit definition
# =============================================================================
# Generated by terraform — edits are reverted on next 'terraform apply'.
# bytes_sec values are already normalized to raw BYTES (input bytes_unit
# B/KB/MB/GB multiplied at terraform-time).
# =============================================================================

[meta]
format_version = 1
name           = ${name}
axis           = disk
generated_at   = ${generated_at}
generated_by   = quick-throttle

%{ for dev, t in devices ~}

[io.${dev}]
%{ if t.read_bytes_sec != null ~}
read_bytes_sec  = ${t.read_bytes_sec}
%{ endif ~}
%{ if t.write_bytes_sec != null ~}
write_bytes_sec = ${t.write_bytes_sec}
%{ endif ~}
%{ if t.read_iops_sec != null ~}
read_iops_sec   = ${t.read_iops_sec}
%{ endif ~}
%{ if t.write_iops_sec != null ~}
write_iops_sec  = ${t.write_iops_sec}
%{ endif ~}

%{ if t.read_bytes_sec_max != null || t.write_bytes_sec_max != null || t.read_iops_sec_max != null || t.write_iops_sec_max != null ~}
[io.${dev}.burst]
%{ if t.read_bytes_sec_max != null ~}
read_bytes_sec_max         = ${t.read_bytes_sec_max}
%{ endif ~}
%{ if t.read_bytes_sec_max_length != null ~}
read_bytes_sec_max_length  = ${t.read_bytes_sec_max_length}
%{ endif ~}
%{ if t.write_bytes_sec_max != null ~}
write_bytes_sec_max        = ${t.write_bytes_sec_max}
%{ endif ~}
%{ if t.write_bytes_sec_max_length != null ~}
write_bytes_sec_max_length = ${t.write_bytes_sec_max_length}
%{ endif ~}
%{ if t.read_iops_sec_max != null ~}
read_iops_sec_max          = ${t.read_iops_sec_max}
%{ endif ~}
%{ if t.read_iops_sec_max_length != null ~}
read_iops_sec_max_length   = ${t.read_iops_sec_max_length}
%{ endif ~}
%{ if t.write_iops_sec_max != null ~}
write_iops_sec_max         = ${t.write_iops_sec_max}
%{ endif ~}
%{ if t.write_iops_sec_max_length != null ~}
write_iops_sec_max_length  = ${t.write_iops_sec_max_length}
%{ endif ~}
%{ endif ~}

%{ endfor ~}
