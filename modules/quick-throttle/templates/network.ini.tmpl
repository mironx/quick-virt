# =============================================================================
# quick-throttle — Network bandwidth limit definition
# =============================================================================
# Generated by terraform — edits are reverted on next 'terraform apply'.
# Rates already normalized to KiB/s (libvirt's native unit; input rate_unit
# KB/MB/GB multiplied at terraform-time, 1 KiB = 1024 bytes).
# =============================================================================

[meta]
format_version = 1
name           = ${name}
axis           = network
generated_at   = ${generated_at}
generated_by   = quick-throttle

%{ for iface, n in interfaces ~}

[net.${iface}]

%{ if n.inbound != null ~}
[net.${iface}.inbound]
%{ if n.inbound.average != null ~}
average = ${n.inbound.average}
%{ endif ~}
%{ if n.inbound.peak != null ~}
peak    = ${n.inbound.peak}
%{ endif ~}
%{ if n.inbound.burst != null ~}
burst   = ${n.inbound.burst}
%{ endif ~}
%{ if n.inbound.floor != null ~}
floor   = ${n.inbound.floor}
%{ endif ~}
%{ endif ~}

%{ if n.outbound != null ~}
[net.${iface}.outbound]
%{ if n.outbound.average != null ~}
average = ${n.outbound.average}
%{ endif ~}
%{ if n.outbound.peak != null ~}
peak    = ${n.outbound.peak}
%{ endif ~}
%{ if n.outbound.burst != null ~}
burst   = ${n.outbound.burst}
%{ endif ~}
%{ if n.outbound.floor != null ~}
floor   = ${n.outbound.floor}
%{ endif ~}
%{ endif ~}

%{ endfor ~}
