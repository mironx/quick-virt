# =============================================================================
# quick-throttle — CPU limit definition
# =============================================================================
# Generated by terraform — edits are reverted on next 'terraform apply'.
# Mode resolution (by downstream apply.sh):
#   RAW     — both period_us AND quota_us set → use verbatim.
#   PERCENT — only percent set → quota_us = vcpu × period × percent / 100
#             (apply.sh queries vcpu via 'virsh dominfo' at apply time).
#   SKIP    — neither set.
# =============================================================================

[meta]
format_version = 1
name           = ${name}
axis           = cpu
generated_at   = ${generated_at}
generated_by   = quick-throttle

[cpu]
%{ if cpu_limit != null && cpu_limit.percent != null ~}
percent   = ${cpu_limit.percent}
%{ else ~}
# percent   =
%{ endif ~}
%{ if cpu_limit != null && cpu_limit.period_us != null ~}
period_us = ${cpu_limit.period_us}
%{ else ~}
# period_us =
%{ endif ~}
%{ if cpu_limit != null && cpu_limit.quota_us != null ~}
quota_us  = ${cpu_limit.quota_us}
%{ else ~}
# quota_us  =
%{ endif ~}
%{ if cpu_limit != null && cpu_limit.shares != null ~}
shares    = ${cpu_limit.shares}
%{ else ~}
# shares    =
%{ endif ~}
