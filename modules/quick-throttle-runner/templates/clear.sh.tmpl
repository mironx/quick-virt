#!/bin/bash
# =============================================================================
# qv-throttle-runner - clear all throttles for VMs in a mapping file
# =============================================================================
# Generated by the quick-throttle-runner Terraform module.
#
# Reads <throttle.ini> mapping (from quick-throttle-apply) and clears every
# throttle on every listed VM (CPU + all dot-suffixed disks + all
# dot-suffixed networks). Profile files (cpu-*.ini, disk-*.ini,
# network-*.ini) are NOT read - clear is a fixed "set everything to zero"
# pass.
#
# Usage:
#   bash qv-throttle.clear.sh <throttle.ini>
# =============================================================================
set -euo pipefail

EXPECTED_FORMAT_VERSION=${format_version}

usage() {
    cat <<EOF
Usage: $0 <throttle.ini>

Iterates every VM section in throttle.ini and clears all axes (CPU + each
disk_profile.<dev> + each network_profile.<idx>) to defaults. Profile
files are not loaded - clear is unconditional.
EOF
    exit 1
}

# -----------------------------------------------------------------------------
# Argument + environment checks
# -----------------------------------------------------------------------------
THROTTLE_INI="$${1:-}"
[ -n "$THROTTLE_INI" ] || usage
[ -f "$THROTTLE_INI" ] || { echo "[error] $THROTTLE_INI not found" >&2; exit 1; }
command -v virsh >/dev/null 2>&1 || { echo "[error] 'virsh' not found - install libvirt-clients" >&2; exit 1; }

# -----------------------------------------------------------------------------
# INI helpers (same shape as apply.sh)
# -----------------------------------------------------------------------------
ini_get() {
    local section="$1" key="$2" file="$3"
    awk -v sec="[$section]" -v k="$key" '
        $0 == sec { ins=1; next }
        /^\[/      { ins=0 }
        ins && $0 ~ "^[[:space:]]*"k"[[:space:]]*=" {
            sub(/^[^=]*=[[:space:]]*/, "")
            sub(/[[:space:]]+$/, "")
            print
            exit
        }
    ' "$file"
}

get_vm_sections() {
    awk -F'[][]' '/^\[[^]]+\]/ && $2 != "meta" { print $2 }' "$1"
}

get_subkeys() {
    local section="$1" prefix="$2" file="$3"
    local in_sec=0 line
    while IFS= read -r line; do
        if [[ "$line" =~ ^\[(.+)\]$ ]]; then
            [[ "$${BASH_REMATCH[1]}" == "$section" ]] && in_sec=1 || in_sec=0
            continue
        fi
        [ $in_sec -eq 1 ] || continue
        if [[ "$line" =~ ^[[:space:]]*$${prefix}\.([^[:space:]=]+)[[:space:]]*= ]]; then
            echo "$${BASH_REMATCH[1]}"
        fi
    done < "$file"
}

# -----------------------------------------------------------------------------
# Format version check
# -----------------------------------------------------------------------------
ACTUAL_VERSION=$(ini_get "meta" "format_version" "$THROTTLE_INI")
if [ "$ACTUAL_VERSION" != "$EXPECTED_FORMAT_VERSION" ]; then
    echo "[error] $THROTTLE_INI: format_version '$ACTUAL_VERSION' != expected $EXPECTED_FORMAT_VERSION" >&2
    exit 1
fi

# -----------------------------------------------------------------------------
# Per-axis clear ops
# -----------------------------------------------------------------------------
clear_cpu() {
    local vm="$1"
    echo "  [cpu] reset (vcpu_quota=-1)"
    virsh schedinfo "$vm" --live --config --set vcpu_quota=-1 >/dev/null
}

clear_disk() {
    local vm="$1" dev="$2"
    echo "  [disk] $dev: reset"
    virsh blkdeviotune "$vm" "$dev" --live --config \
        --read-bytes-sec 0 --write-bytes-sec 0 \
        --read-iops-sec 0 --write-iops-sec 0 \
        --read-bytes-sec-max 0 --read-bytes-sec-max-length 0 \
        --write-bytes-sec-max 0 --write-bytes-sec-max-length 0 \
        --read-iops-sec-max 0 --read-iops-sec-max-length 0 \
        --write-iops-sec-max 0 --write-iops-sec-max-length 0 \
        >/dev/null
}

clear_network() {
    local vm="$1" idx="$2"
    local vnet
    vnet=$(virsh domiflist "$vm" | awk -v target=$((idx + 3)) 'NR == target { print $1 }')
    if [ -z "$vnet" ]; then
        echo "  [net] iface[$idx]: not found via domiflist - skipping"
        return
    fi
    echo "  [net] iface[$idx] ($vnet): reset"
    # --config omitted (see apply.sh.tmpl for rationale).
    virsh domiftune "$vm" "$vnet" --live \
        --inbound  "0,0,0,0" --outbound "0,0,0" \
        >/dev/null || true
}

# -----------------------------------------------------------------------------
# Main loop
# -----------------------------------------------------------------------------
echo "[*] Reading mapping: $THROTTLE_INI"
echo ""

for vm in $(get_vm_sections "$THROTTLE_INI"); do
    if ! virsh dominfo "$vm" >/dev/null 2>&1; then
        echo "[warn] VM '$vm' not found - skipping"
        continue
    fi
    echo "[*] $vm"

    clear_cpu "$vm"

    while IFS= read -r dev; do
        [ -z "$dev" ] && continue
        clear_disk "$vm" "$dev"
    done < <(get_subkeys "$vm" "disk_profile" "$THROTTLE_INI")

    while IFS= read -r idx; do
        [ -z "$idx" ] && continue
        clear_network "$vm" "$idx"
    done < <(get_subkeys "$vm" "network_profile" "$THROTTLE_INI")

    echo ""
done

echo "[ok] Clear complete"
