#!/bin/bash
# =============================================================================
# qv-throttle-runner — apply throttle limits per a mapping file
# =============================================================================
# Generated by the quick-throttle-runner Terraform module.
#
# Reads <throttle.ini> mapping (from quick-throttle-apply) and per-axis
# profile files (from quick-throttle, e.g. cpu-cap25.ini, disk-slow1.ini,
# network-bandit.ini). For each VM section:
#   - cpu_profile         -> CPU throttle via 'virsh schedinfo'
#   - disk_profile.<dev>  -> I/O throttle via 'virsh blkdeviotune'
#   - network_profile.<i> -> bandwidth via 'virsh domiftune'
#
# Value 'null' (or empty) -> that axis is RESET to defaults (unthrottle).
# Value '<filename>.ini'  -> loaded relative to throttle.ini's directory.
#
# Usage:
#   bash qv-throttle.apply.sh <throttle.ini>
# =============================================================================
set -euo pipefail

EXPECTED_FORMAT_VERSION=${format_version}

usage() {
    cat <<EOF
Usage: $0 <throttle.ini>

Reads the VM-to-profile mapping in throttle.ini and applies all
throttles via virsh. Profile filenames are resolved relative to
throttle.ini's directory.
EOF
    exit 1
}

# -----------------------------------------------------------------------------
# Argument + environment checks
# -----------------------------------------------------------------------------
THROTTLE_INI="$${1:-}"
[ -n "$THROTTLE_INI" ] || usage
[ -f "$THROTTLE_INI" ] || { echo "[error] $THROTTLE_INI not found" >&2; exit 1; }
command -v virsh >/dev/null 2>&1 || { echo "[error] 'virsh' not found - install libvirt-clients" >&2; exit 1; }

PROFILES_DIR="$(cd "$(dirname "$THROTTLE_INI")" && pwd)"

# -----------------------------------------------------------------------------
# INI helpers
# -----------------------------------------------------------------------------
ini_get() {
    local section="$1" key="$2" file="$3"
    awk -v sec="[$section]" -v k="$key" '
        $0 == sec { ins=1; next }
        /^\[/      { ins=0 }
        ins && $0 ~ "^[[:space:]]*"k"[[:space:]]*=" {
            sub(/^[^=]*=[[:space:]]*/, "")
            sub(/[[:space:]]+$/, "")
            print
            exit
        }
    ' "$file"
}

# List VM section names (excluding [meta]).
get_vm_sections() {
    awk -F'[][]' '/^\[[^]]+\]/ && $2 != "meta" { print $2 }' "$1"
}

# Yield "suffix|value" for each <prefix>.<suffix> = <value> line in a section.
get_subkeys() {
    local section="$1" prefix="$2" file="$3"
    local in_sec=0 line
    while IFS= read -r line; do
        if [[ "$line" =~ ^\[(.+)\]$ ]]; then
            [[ "$${BASH_REMATCH[1]}" == "$section" ]] && in_sec=1 || in_sec=0
            continue
        fi
        [ $in_sec -eq 1 ] || continue
        if [[ "$line" =~ ^[[:space:]]*$${prefix}\.([^[:space:]=]+)[[:space:]]*=[[:space:]]*(.+)[[:space:]]*$ ]]; then
            echo "$${BASH_REMATCH[1]}|$${BASH_REMATCH[2]}"
        fi
    done < "$file"
}

validate_format_version() {
    local file="$1" expected="$2"
    local actual
    actual=$(ini_get "meta" "format_version" "$file")
    if [ "$actual" != "$expected" ]; then
        echo "[error] $file: format_version '$actual' != expected $expected" >&2
        return 1
    fi
}

# -----------------------------------------------------------------------------
# Mapping file format check
# -----------------------------------------------------------------------------
validate_format_version "$THROTTLE_INI" "$EXPECTED_FORMAT_VERSION" || exit 1

# -----------------------------------------------------------------------------
# CPU apply
# -----------------------------------------------------------------------------
apply_cpu_default() {
    local vm="$1"
    echo "  [cpu] reset (vcpu_quota=-1)"
    virsh schedinfo "$vm" --live --config --set vcpu_quota=-1 >/dev/null
}

apply_cpu_profile() {
    local vm="$1" file="$2"
    validate_format_version "$file" "$EXPECTED_FORMAT_VERSION" || return 0

    local percent period_us quota_us shares
    percent=$(ini_get   "cpu" "percent"   "$file")
    period_us=$(ini_get "cpu" "period_us" "$file")
    quota_us=$(ini_get  "cpu" "quota_us"  "$file")
    shares=$(ini_get    "cpu" "shares"    "$file")

    local final_period="" final_quota=""
    if [ -n "$period_us" ] && [ -n "$quota_us" ]; then
        final_period="$period_us"
        final_quota="$quota_us"
        echo "  [cpu] RAW period=$${final_period}us quota=$${final_quota}us"
    elif [ -n "$percent" ]; then
        final_period="$${period_us:-100000}"
        local vcpu
        vcpu=$(virsh dominfo "$vm" | awk '/^CPU\(s\):/{print $2}')
        final_quota=$(( vcpu * final_period * percent / 100 ))
        echo "  [cpu] PERCENT $${percent}% x $${vcpu} vcpu x $${final_period}us -> quota=$${final_quota}us"
    else
        echo "  [cpu] SKIP (no values in $file)"
        return
    fi

    local cmd=(virsh schedinfo "$vm" --live --config
               --set "vcpu_period=$final_period"
               --set "vcpu_quota=$final_quota")
    [ -n "$shares" ] && cmd+=(--set "cpu_shares=$shares")
    "$${cmd[@]}" >/dev/null
}

# -----------------------------------------------------------------------------
# Disk apply
# -----------------------------------------------------------------------------
apply_disk_default() {
    local vm="$1" dev="$2"
    echo "  [disk] $dev: reset (all zero = unlimited)"
    virsh blkdeviotune "$vm" "$dev" --live --config \
        --read-bytes-sec 0 --write-bytes-sec 0 \
        --read-iops-sec 0 --write-iops-sec 0 \
        --read-bytes-sec-max 0 --read-bytes-sec-max-length 0 \
        --write-bytes-sec-max 0 --write-bytes-sec-max-length 0 \
        --read-iops-sec-max 0 --read-iops-sec-max-length 0 \
        --write-iops-sec-max 0 --write-iops-sec-max-length 0 \
        >/dev/null
}

apply_disk_profile() {
    local vm="$1" dev="$2" file="$3"
    validate_format_version "$file" "$EXPECTED_FORMAT_VERSION" || return 0

    echo "  [disk] $dev: throttle ($(basename "$file"))"
    local cmd=(virsh blkdeviotune "$vm" "$dev" --live --config)

    local v key flag
    for key in read_bytes_sec write_bytes_sec read_iops_sec write_iops_sec; do
        v=$(ini_get "io.$dev" "$key" "$file")
        if [ -n "$v" ]; then
            flag="--$(echo "$key" | tr _ -)"
            cmd+=("$flag" "$v")
        fi
    done
    for key in read_bytes_sec_max read_bytes_sec_max_length \
               write_bytes_sec_max write_bytes_sec_max_length \
               read_iops_sec_max  read_iops_sec_max_length \
               write_iops_sec_max write_iops_sec_max_length; do
        v=$(ini_get "io.$dev.burst" "$key" "$file")
        if [ -n "$v" ]; then
            flag="--$(echo "$key" | tr _ -)"
            cmd+=("$flag" "$v")
        fi
    done

    "$${cmd[@]}" >/dev/null
}

# -----------------------------------------------------------------------------
# Network apply - index -> vnet name resolved via 'virsh domiflist'.
# Header is 2 lines; first iface is at NR=3 -> mapping NR = idx + 3.
# -----------------------------------------------------------------------------
resolve_vnet() {
    local vm="$1" idx="$2"
    virsh domiflist "$vm" | awk -v target=$((idx + 3)) 'NR == target { print $1 }'
}

apply_network_default() {
    local vm="$1" idx="$2"
    local vnet
    vnet=$(resolve_vnet "$vm" "$idx")
    if [ -z "$vnet" ]; then
        echo "  [net] iface[$idx]: not found via domiflist - skipping"
        return
    fi
    echo "  [net] iface[$idx] ($vnet): reset"
    # --config omitted: inactive XML lacks <target dev='vnetN'/> (assigned at
    # runtime), so virsh --config rejects vnet aliases. Network throttle is
    # live-only and won't survive VM reboot — acceptable for chaos sessions.
    virsh domiftune "$vm" "$vnet" --live \
        --inbound  "0,0,0,0" --outbound "0,0,0" \
        >/dev/null || true
}

apply_network_profile() {
    local vm="$1" idx="$2" file="$3"
    validate_format_version "$file" "$EXPECTED_FORMAT_VERSION" || return 0

    local vnet
    vnet=$(resolve_vnet "$vm" "$idx")
    if [ -z "$vnet" ]; then
        echo "  [net] iface[$idx]: not found via domiflist - skipping"
        return
    fi

    echo "  [net] iface[$idx] ($vnet): throttle ($(basename "$file"))"

    local in_avg in_peak in_burst in_floor out_avg out_peak out_burst
    in_avg=$(ini_get   "net.$idx.inbound"  "average" "$file")
    in_peak=$(ini_get  "net.$idx.inbound"  "peak"    "$file")
    in_burst=$(ini_get "net.$idx.inbound"  "burst"   "$file")
    in_floor=$(ini_get "net.$idx.inbound"  "floor"   "$file")
    out_avg=$(ini_get  "net.$idx.outbound" "average" "$file")
    out_peak=$(ini_get "net.$idx.outbound" "peak"    "$file")
    out_burst=$(ini_get "net.$idx.outbound" "burst"  "$file")

    local in_str="$${in_avg:-0},$${in_peak:-0},$${in_burst:-0},$${in_floor:-0}"
    local out_str="$${out_avg:-0},$${out_peak:-0},$${out_burst:-0}"

    # --config omitted: inactive XML lacks <target dev='vnetN'/> (assigned at
    # runtime), so virsh --config rejects vnet aliases. Network throttle is
    # live-only and won't survive VM reboot — acceptable for chaos sessions.
    virsh domiftune "$vm" "$vnet" --live \
        --inbound "$in_str" --outbound "$out_str" \
        >/dev/null || true
}

# -----------------------------------------------------------------------------
# Main loop - one pass per VM section
# -----------------------------------------------------------------------------
echo "[*] Reading mapping: $THROTTLE_INI (format_version=$EXPECTED_FORMAT_VERSION)"
echo "[*] Profiles dir:    $PROFILES_DIR"
echo ""

for vm in $(get_vm_sections "$THROTTLE_INI"); do
    if ! virsh dominfo "$vm" >/dev/null 2>&1; then
        echo "[warn] VM '$vm' not found in libvirt - skipping"
        continue
    fi
    echo "[*] $vm"

    # CPU
    cpu_profile=$(ini_get "$vm" "cpu_profile" "$THROTTLE_INI")
    if [ -z "$cpu_profile" ] || [ "$cpu_profile" = "null" ]; then
        apply_cpu_default "$vm"
    else
        apply_cpu_profile "$vm" "$PROFILES_DIR/$cpu_profile"
    fi

    # Disks
    while IFS= read -r entry; do
        [ -z "$entry" ] && continue
        dev="$${entry%%|*}"
        profile="$${entry##*|}"
        if [ -z "$profile" ] || [ "$profile" = "null" ]; then
            apply_disk_default "$vm" "$dev"
        else
            apply_disk_profile "$vm" "$dev" "$PROFILES_DIR/$profile"
        fi
    done < <(get_subkeys "$vm" "disk_profile" "$THROTTLE_INI")

    # Networks
    while IFS= read -r entry; do
        [ -z "$entry" ] && continue
        idx="$${entry%%|*}"
        profile="$${entry##*|}"
        if [ -z "$profile" ] || [ "$profile" = "null" ]; then
            apply_network_default "$vm" "$idx"
        else
            apply_network_profile "$vm" "$idx" "$PROFILES_DIR/$profile"
        fi
    done < <(get_subkeys "$vm" "network_profile" "$THROTTLE_INI")

    echo ""
done

echo "[ok] Apply complete"
